# Show developer seed Cards (unreviewed) in a production build. Never set in a release (D-012).
# Development (`next dev`) shows them without this.
OGBIFO_ALLOW_UNREVIEWED=1

# Browser tests only. Plays a synthetic test voice as the reference for the seed Cards. Leave unset: nobody
# should hear a robotic voice. Real references come from recordings (docs/RECORDING_A_REFERENCE.md).
# OGBIFO_SYNTHETIC_REFERENCE=1

# Show the Resonance Score number. Off until calibration passes (D-036). Studio never shows it.
NEXT_PUBLIC_SHOW_RESONANCE_NUMBER=1

# Switch on the reviewer annotation tool at /reviewer/annotate (D-033). There are no accounts yet, so this is per deployment. Never on a public site.
OGBIFO_ENABLE_REVIEWER_TOOLS=1

# PostgreSQL connection string (D-040), e.g. postgres://user:pass@host:5432/ogbifo?sslmode=require
# Apply the schema first:  DATABASE_URL=... npm run migrate -w @ogbifo/web
# Without it, development keeps accounts in memory and production keeps sign-in closed.
# DATABASE_URL=

# Sign-in by email link (D-022). The origin sign-in links point at. Required in production;
# defaults to http://localhost:PORT in development. Never trust the Host header for this.
# OGBIFO_BASE_URL=https://example.org

# Development mailbox: the sign-in page shows the link instead of emailing it. Honoured only
# when OGBIFO_BASE_URL is localhost or 127.0.0.1; anywhere else sign-in stays closed because
# no email provider is wired yet (OPEN_CONFLICTS #21).
# OGBIFO_DEV_EMAIL=1
